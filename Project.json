{
  "configs": {
    "Debug": "debug",
    "Release": "release"
  },
  "name": "G Timer",
  "options": {
    "groupSortPosition": "bottom",
    "transitivelyLinkDependencies": false
  },
  "settings": {
    "CODE_SIGN_IDENTITY": "-"
  },
  "targets": {
    "G Timer": {
      "dependencies": [
        {
          "embed": true,
          "target": "G Timer Widget Extension",
          "destinationFilters": ["iOS"]
        }
      ],
      "deploymentTarget": {
        "iOS": "17.0",
        "macOS": "14.0"
      },
      "entitlements": {
        "path": "App/App.entitlements",
        "properties": {
          "com.apple.security.app-sandbox": true,
          "com.apple.security.network.client": true,
          "com.apple.security.device.camera": true,
          "com.apple.security.application-groups": ["group.app.bitrig.new.cc0b1024-f41a-488c-b5dd-b6845c513c01"]
        }
      },
      "info": {
        "path": "App/Info.plist",
        "properties": {
          "CFBundleDisplayName": "G Timer",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "1",
          "ITSAppUsesNonExemptEncryption": false,
          "NSLocationWhenInUseUsageDescription": "G Timer can optionally record your location with each dose log for your own reference.",
          "NSPhotoLibraryUsageDescription": "G Timer uses your photo library to set a profile picture.",
          "NSCameraUsageDescription": "G Timer uses the camera to take a profile picture when you choose that option.",
          "UILaunchScreen": {},
          "LSApplicationCategoryType": "public.app-category.healthcare-fitness",
          "UISupportedInterfaceOrientations": [
            "UIInterfaceOrientationPortrait",
            "UIInterfaceOrientationPortraitUpsideDown"
          ],
          "CFBundleURLTypes": [
            {
              "CFBundleURLSchemes": ["gtimer"],
              "CFBundleURLName": "app.gtimer"
            }
          ]
        }
      },
      "platform": "auto",
      "settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CURRENT_PROJECT_VERSION": "1",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.cc0b1024-f41a-488c-b5dd-b6845c513c01",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2"
      },
      "sources": [
        { "path": "App" },
        { "path": "Shared" }
      ],
      "supportedDestinations": ["iOS", "macOS"],
      "type": "application"
    },
    "G Timer Watch": {
      "deploymentTarget": "10.0",
      "info": {
        "path": "Watch/Info.plist",
        "properties": {
          "CFBundleDisplayName": "G Timer",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "1",
          "ITSAppUsesNonExemptEncryption": false,
          "WKApplication": true,
          "WKCompanionAppBundleIdentifier": "app.bitrig.new.cc0b1024-f41a-488c-b5dd-b6845c513c01"
        }
      },
      "platform": "watchOS",
      "settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CURRENT_PROJECT_VERSION": "1",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.cc0b1024-f41a-488c-b5dd-b6845c513c01.watchkitapp",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0"
      },
      "sources": [
        { "path": "Watch" },
        { "path": "App/Assets.xcassets" },
        { "path": "Shared" }
      ],
      "type": "application"
    },
    "G Timer Widget Extension": {
      "deploymentTarget": {
        "iOS": "17.0",
        "macOS": "14.0"
      },
      "entitlements": {
        "path": "Widget Extension/Widget.entitlements",
        "properties": {
          "com.apple.security.app-sandbox": true,
          "com.apple.security.application-groups": ["group.app.bitrig.new.cc0b1024-f41a-488c-b5dd-b6845c513c01"]
        }
      },
      "info": {
        "path": "Widget Extension/Info.plist",
        "properties": {
          "CFBundleDisplayName": "G Timer Widget Extension",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "1",
          "ITSAppUsesNonExemptEncryption": false,
          "NSExtension": {
            "NSExtensionPointIdentifier": "com.apple.widgetkit-extension"
          }
        }
      },
      "platform": "auto",
      "settings": {
        "APPLICATION_EXTENSION_API_ONLY": "YES",
        "CURRENT_PROJECT_VERSION": "1",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.cc0b1024-f41a-488c-b5dd-b6845c513c01.widget",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SKIP_INSTALL": "YES",
        "SWIFT_VERSION": "5.0"
      },
      "sources": [
        { "path": "Widget Extension" },
        { "path": "Shared" }
      ],
      "supportedDestinations": ["iOS", "macOS"],
      "type": "app-extension"
    }
  }
}
